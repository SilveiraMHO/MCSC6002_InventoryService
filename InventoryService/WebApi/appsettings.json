{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    // Password from .env via docker-compose.
    "DefaultConnection": "Server=sqlserver,1433;Database=MCSC6002_InventoryDB;User Id=sa;Encrypt=True;TrustServerCertificate=True;"
  },
  "TokenSettings": {
    "PublicKeyPath": "/keys/jwt-public.pem"
  },
  "MutualTls": {
    "ServerCertificatePath": "/keys/inventory.pfx",
    "CaCertificatePath": "/keys/ca.crt",
    "AllowedClientName": "api-gateway"
  },
  "InventoryServiceClientSettings": {
    "ApiGatewayUrl": "https://gateway:7000"
  },
  "RabbitMqSettings": {
    "Host": "rabbitmq",
    "Port": 5671, // TLS only.
    "ServerName": "rabbitmq",
    "CaCertificatePath": "/keys/ca.crt",
    "UserName": "", // From .env via docker-compose.
    "Password": "",
    "SigningKey": "", // From .env via docker-compose.
    "ProductCreatedEventQueue": "ProductCreatedEventQueue",
    "ProductDeletedEventQueue": "ProductDeletedEventQueue",
    "RetryInMilliseconds": 100
  },
  "AllowedHosts": "*"
}
