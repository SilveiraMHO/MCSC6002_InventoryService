{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    // Full string incl. password comes from user-secrets (MCSC6002_System/scripts/set-user-secrets.sh).
    "DefaultConnection": "Server=127.0.0.1,1433;Database=MCSC6002_InventoryDB;User Id=sa;Encrypt=True;TrustServerCertificate=True;"
  },
  "TokenSettings": {
    "PublicKeyPath": "../../../keys/jwt-public.pem"
  },
  "MutualTls": {
    "ServerCertificatePath": "../../../keys/tls/service.pfx",
    "CaCertificatePath": "../../../keys/tls/ca.crt",
    "AllowedClientName": "api-gateway"
  },
  "InventoryServiceClientSettings": {
    "ApiGatewayUrl": "https://localhost:7000"
  },
  "RabbitMqSettings": {
    "Host": "127.0.0.1",
    "UserName": "", // From user-secrets.
    "Password": "",
    "ProductCreatedEventQueue": "ProductCreatedEventQueue",
    "ProductDeletedEventQueue": "ProductDeletedEventQueue",
    "RetryInMilliseconds": 100
  },
  "AllowedHosts": "*"
}
